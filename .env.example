# ============================================================
# SOLAR INTELLIGENCE — Environment Configuration
# Copy to .env and fill in your values before running
# ============================================================

# --- App ---
SI_ENV=development          # development | staging | production
SI_LOG_LEVEL=INFO
SI_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# --- Layer I: Core (Kafka + Flink + GraphRAG) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_DOCS=si.core.raw_documents
KAFKA_TOPIC_FUSED=si.core.fused_entities
KAFKA_TOPIC_AUDIT=si.core.audit
KAFKA_CONSUMER_GROUP=si-core-group
KAFKA_TRANSACTIONAL_ID=si-core-fusion-producer-1

FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=

FLINK_JOBMANAGER_HOST=localhost
FLINK_JOBMANAGER_PORT=8081

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS_PER_JOB=100000
OPENAI_HARD_COST_CEILING_USD=50.0

# --- Layer II: Radiative (Vector + Cache) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=si_intelligence
VECTOR_BACKEND=pgvector        # pgvector | milvus | govector
VECTOR_DIMENSION=1024

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=si_vectors
POSTGRES_USER=si_user
POSTGRES_PASSWORD=si_password

EMBEDDING_HOST=localhost
EMBEDDING_PORT=8080
EMBEDDING_MODEL=BAAI/bge-m3

GPTCACHE_SIMILARITY_THRESHOLD=0.85
GPTCACHE_MAX_SIZE=10000
CACHE_HOT_TTL_SECONDS=3600
CACHE_WARM_TTL_SECONDS=86400
CACHE_COSINE_DRIFT_THRESHOLD=0.08

# --- Layer III: Convective (Router + Agents) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

VLLM_ROUTER_HOST=localhost
VLLM_ROUTER_PORT=8100
ROUTER_COSINE_THRESHOLD=0.78
ROUTER_FALLBACK_ERROR_RATE=0.05
ROUTER_FALLBACK_WINDOW_SECONDS=60

AGENT_MAX_WORKFLOW_DURATION=3600
AGENT_STATE_TTL_MULTIPLIER=1.2

COT_SOFT_TOKEN_LIMIT=4096
COT_HARD_TOKEN_LIMIT=8192
STANDARD_SOFT_TOKEN_LIMIT=2048
STANDARD_HARD_TOKEN_LIMIT=4096
EDGE_SOFT_TOKEN_LIMIT=512
EDGE_HARD_TOKEN_LIMIT=1024

# --- Layer IV: Photosphere (API + Kong + MCP) ---
API_HOST=0.0.0.0
API_PORT=8888
API_WORKERS=4

KONG_ADMIN_URL=http://localhost:8002
KONG_PROXY_URL=http://localhost:8000

MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=9000

TOKEN_ACCOUNTING_BACKEND=redis   # redis | memory
TOKEN_BUCKET_HOUR_LIMIT=50000
TOKEN_BUCKET_MINUTE_LIMIT=1000

MODERATION_ENABLED=true
MODERATION_ASYNC_THRESHOLD_MS=15

# --- Layer V: Corona (Telemetry + Webhooks + Signing) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=solar-intelligence
OTEL_TRACE_SAMPLE_RATE=1.0

JAEGER_HOST=localhost
JAEGER_PORT=16686

WEBHOOK_MAX_RETRIES=3
WEBHOOK_BACKOFF_SECONDS=1,4,16
WEBHOOK_DLQ_TOPIC=si.corona.webhook_dlq
PAGERDUTY_INTEGRATION_KEY=your-pd-key-here

ECDSA_SIGNING_ENABLED=true
ECDSA_PRIVATE_KEY_PATH=certs/signing.key
ECDSA_PUBLIC_KEY_PATH=certs/signing.pub

EDGE_QUANTIZATION=INT8           # INT8 | INT4 | GGUF
EDGE_ACCURACY_DELTA_THRESHOLD=0.03

# --- mTLS ---
MTLS_ENABLED=true
MTLS_CA_CERT_PATH=certs/ca.crt
MTLS_CERT_PATH=certs/photosphere.crt
MTLS_KEY_PATH=certs/photosphere.key

# --- SLA Targets ---
SLA_P50_MS=150
SLA_P95_MS=500
SLA_P99_MS=1500
SLA_AVAILABILITY_PCT=99.5
SLA_RTO_MINUTES=30
SLA_RPO_MINUTES=5
