FROM python:3.11-slim
RUN groupadd -r si && useradd -r -g si si
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl openssl && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install uv && uv pip install --system --no-cache -r requirements.txt
COPY . .
RUN chown -R si:si /app
USER si
CMD ["python", "-m", "uvicorn", "photosphere.api.main:app", "--host", "0.0.0.0", "--port", "8888"]
