Set-Content -Path .gitignore -Value @"
# Environments
venv/
env/
.env

# Python
__pycache__/
*.py[cod]
*$py.class

# IDEs
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Docker
.docker/
docker-compose.override.yml

# Solar Intelligence Data Volumes
data/
milvus-data/
postgres-data/
redis-data/
redpanda-data/
falkordb-data/
etcd-data/
minio-data/
grafana-data/
prometheus-data/
hf-cache/
"@